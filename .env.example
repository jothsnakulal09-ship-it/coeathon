# Database Connection (SQLite default, PostgreSQL supported)
DATABASE_URL=sqlite:///./study_planner.db
# For PostgreSQL: postgresql://username:password@localhost:5432/study_planner_db

# Security
JWT_SECRET=super-secret-adaptive-study-planner-key-2026

# Optional: Google Gemini API Key for LLM Study Assistant
# If left empty, the application uses its built-in rule-based intelligent AI Study Coach
GEMINI_API_KEY=

# File Storage
UPLOAD_DIR=./uploads
